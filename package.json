{
  "name": "sistema-gestion-digital",
  "version": "1.0.0",
  "description": "Sistema de Gestión de Identidad Digital (SGID): autenticación biométrica multifactor, roles y permisos, integración gubernamental y seguridad, con 9 patrones de diseño",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build && node dist/index.js",
    "demo": "npm run build && node dist/demo-interactivo.js",
    "web": "npm run build && node dist/web/server.js",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --watch",
    "datos:borrar": "node -e \"require('fs').rmSync('data',{recursive:true,force:true});console.log('Carpeta data/ borrada')\""
  },
  "keywords": [
    "singleton",
    "factory-method",
    "builder",
    "adapter",
    "bridge",
    "composite",
    "decorator",
    "flyweight",
    "proxy",
    "hexagonal",
    "identidad-digital",
    "typescript",
    "oauth2",
    "jwt",
    "auditoria"
  ],
  "author": "Keanon Jeanpierre Angarita Olarte",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.2",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "express": "^4.22.3"
  }
}
