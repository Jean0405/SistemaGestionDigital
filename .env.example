# Copia este archivo como .env (no se sube al repositorio) y cambia los secretos.
# `npm run web` lo lee al arrancar.

# Firma de los tokens JWT (mínimo 10 caracteres).
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Clave para cifrar documento, teléfono, correo y plantilla del rostro (mínimo 16 caracteres).
# Si la cambias, los usuarios ya registrados no se podrán descifrar.
DATOS_CLAVE=cambia-esta-clave-de-cifrado-larga

# Con cámara real, una misma persona suele dar un parecido entre 0.5 y 0.7.
BIOMETRIA_UMBRAL=0.5

# Minutos de vigencia de la credencial / token.
JWT_EXPIRACION_MIN=15

API_PORT=3000
# SGID_DATOS_DIR=data
